{
  "name": "address-format-project",
  "version": "1.0.0",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nodemon -L ./src/app.ts",
    "start": "ts-node ./src/app.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:emarkland00/address-format.git"
  },
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/emarkland00/address-format",
  "dependencies": {
    "axios": "1.16.1",
    "body-parser": "2.2.2",
    "cookie-parser": "1.4.7",
    "debug": "4.4.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "morgan": "1.10.1",
    "serve-favicon": "2.5.1",
    "string-template": "1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/body-parser": "1.19.6",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "25.9.1",
    "@types/string-template": "1.0.7",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "nodemon": "3.1.14",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.8"
  }
}
